
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# Price fallback when Yahoo Finance is blocked (cloud hosts) — polygon.io / massive.com
POLYGON_API_KEY=


NEWS_API_KEY=

# --- MLflow Tracking Server ---
# Local development default — change to your EC2 URL after deployment
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=finsight-runs

# --- Application Settings ---
# Directory where generated PDF reports are saved
REPORTS_DIR=data/reports
# Directory for monitoring reference datasets
REFERENCE_DATA_DIR=data/reference
# Claude model to use for report generation
LLM_MODEL=claude-opus-5-5
# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
